<!-- boris.gb 2026-10-30 16:03 - Wazuh rules for SafeLine WAF events forwarded by wafpanel (JSON without a syslog header, field product=safeline); a separate file, local_rules.xml stays untouched -->
<!-- Install: /var/ossec/etc/rules/safeline_rules.xml (root:wazuh 0660), then wazuh-analysisd -t && systemctl restart wazuh-manager -->
<!-- action and url are static Wazuh fields: match them with <action>, never <field name="action">. -->

<group name="safeline,waf,web,attack,">

  <!-- Any SafeLine event. Level 3 reaches alerts.json with the default log_alert_level. -->
  <rule id="100700" level="3">
    <decoded_as>json</decoded_as>
    <field name="product">^safeline$</field>
    <description>SafeLine WAF: $(attack_type_name) from $(src_ip) to $(host)$(url) [$(action)]</description>
    <options>no_full_log</options>
  </rule>

  <!-- The request was blocked. -->
  <rule id="100701" level="5">
    <if_sid>100700</if_sid>
    <action>deny</action>
    <description>SafeLine WAF blocked $(attack_type_name) from $(src_ip) to $(host)$(url)</description>
    <options>no_full_log</options>
  </rule>

  <!-- The attack got through (site in Monitoring mode or the rule does not block). -->
  <rule id="100702" level="6">
    <if_sid>100700</if_sid>
    <action>pass</action>
    <description>SafeLine WAF passed $(attack_type_name) from $(src_ip) to $(host)$(url)</description>
    <options>no_full_log</options>
  </rule>

  <!-- Dangerous types: backdoor(5), code execution(7), code(8) and command(9) injection, XXE(17), path traversal(20), smuggling(36). -->
  <rule id="100703" level="10">
    <if_sid>100701, 100702</if_sid>
    <field name="attack_type">^5$|^7$|^8$|^9$|^17$|^20$|^36$</field>
    <description>SafeLine WAF: dangerous attack $(attack_type_name) from $(src_ip) to $(host)$(url) [$(action)]</description>
    <options>no_full_log</options>
  </rule>

  <!-- Burst: 20 events from one IP within 5 minutes. -->
  <rule id="100704" level="10" frequency="20" timeframe="300">
    <if_matched_sid>100700</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>SafeLine WAF: attack burst from $(src_ip) (20+ events in 5 minutes)</description>
    <options>no_full_log</options>
  </rule>

</group>
